    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.5.18",
    "@rentflow/api": "workspace:*",
    "@rentflow/core": "workspace:*",
    "@rentflow/native": "workspace:*",
    "@rentflow/ui": "workspace:*",
