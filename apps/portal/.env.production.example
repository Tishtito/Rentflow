# Production build of the portal app (https://rentflow.codepasstech.top).
# deploy/deploy.sh builds with these values: copy to .env.production (or let the script do it).
#
# The web app calls the API on its own origin (/api/… on rentflow.codepasstech.top; nginx hands it to Laravel), so this
# is only used by the Android / iOS builds (pnpm cap:sync) and token-mode builds.
VITE_API_URL=https://api.rentflow.codepasstech.top
# "Continue with Google" web client ID (same as the backend's GOOGLE_CLIENT_IDS). Empty = button hidden.
VITE_GOOGLE_CLIENT_ID=
# iOS client ID for the native app (optional).
VITE_GOOGLE_IOS_CLIENT_ID=
