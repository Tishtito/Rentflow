{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "outputs": []
    },
    "cap:sync": {
      "cache": false,
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
